{
  "name": "@compdfkit_pdf_sdk/react_native",
  "version": "3.2.0",
  "description": "ComPDFKit for React Native is a comprehensive SDK that allows you to quickly add PDF functionality to Android, iOS, and React Native applications.",
  "main": "./lib/commonjs/src/index.js",
  "module": "./lib/module/src/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.tsx",
      "import": "./lib/module/src/index.js",
      "require": "./lib/commonjs/src/index.js",
      "default": "./lib/commonjs/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "app.plugin.js",
    "plugin",
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "API.md",
    "CHANGELOG.md",
    "CONFIGURATION.md",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!android/src/androidTest",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/CLAUDE.md",
    "!**/AGENTS.md",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn --cwd example",
    "test": "jest",
    "test:signature-example": "jest --config jest.signature-example.config.js",
    "test:ci": "jest --ci --maxWorkers=2 --coverage",
    "ci": "bash tool/ci/all.sh",
    "ci:bridge": "node tool/ci/check-native-bridge.mjs --baseline tool/ci/bridge-baseline.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "build": "del-cli lib && yarn build:commonjs && yarn build:module && yarn build:types",
    "build:commonjs": "tsc -p tsconfig.build.commonjs.json",
    "build:module": "tsc -p tsconfig.build.module.json",
    "build:types": "tsc -p tsconfig.build.types.json",
    "prepare": "yarn build",
    "release": "yarn prepare && release-it",
    "docs": "typedoc",
    "docs:html": "typedoc",
    "docs:check": "node tool/docs/validate-docs.mjs && typedoc --emit none"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "pdf",
    "cross-platform",
    "pdf-viewer",
    "pdf-document",
    "pdf-editor",
    "compdfkit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ComPDFKit/compdfkit-pdf-sdk-react-native"
  },
  "author": "ComPDFKit <youna@compdf.com> (https://github.com/ComPDFKit)",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/ComPDFKit/compdfkit-pdf-sdk-react-native/issues"
  },
  "homepage": "https://www.compdf.com/react-native",
  "devDependencies": {
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.0",
    "del-cli": "^5.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-test-renderer": "19.2.3",
    "typedoc": "^0.28.14",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=7.0.0",
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  }
}
