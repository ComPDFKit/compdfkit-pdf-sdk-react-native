# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CompdfkitPdfExample' do
  config = use_native_modules!
  if ENV['COMPDFKIT_IOS_LOCAL'] == '1'
    # Pre-release SDK synced from the iOS SDK repository into example/vendor (git-ignored).
    pod 'ComPDFKit', :path => '../vendor/compdfkit-ios-3.2.0/ComPDFKit'
    pod 'ComPDFKit_Tools', :path => '../vendor/compdfkit-ios-3.2.0/ComPDFKit_Tools'
  else
    pod 'ComPDFKit', :git => 'https://github.com/ComPDFKit/compdfkit-pdf-sdk-ios-swift.git', :tag => '3.2.0'
    pod 'ComPDFKit_Tools', :git => 'https://github.com/ComPDFKit/compdfkit-pdf-sdk-ios-swift.git', :tag => '3.2.0'
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'CompdfkitPdfExampleTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 rejects deployment targets below iOS 15.0. Some pods (e.g. the
    # react-native-image-picker privacy resource bundle) still declare 9.0, so
    # raise every pod target to the app's minimum.
    min_ios_version = min_ios_version_supported
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target.nil? || Gem::Version.new(deployment_target) < Gem::Version.new(min_ios_version)
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version
        end
      end
    end

    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'

      target.build_configurations.each do |config|
        # fmt 11.0.2 fails to compile with Apple Clang's C++20 consteval checks.
        # RCT-Folly pins this fmt version, so keep the workaround scoped to fmt.
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
  end
end
